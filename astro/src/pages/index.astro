---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoLightbox from "../components/PhotoLightbox.astro";
import HomeLead from "../components/HomeLead.astro";
import HomeFeature from "../components/HomeFeature.astro";
import EventCard from "../components/EventCard.astro";
import { site } from "../data/site";
import { getEvents, getHomeFeature } from "../lib/wordpress";

const events = await getEvents();
const feature = await getHomeFeature();
const nextEvent = events[0];
---

<BaseLayout title="Union Instrumentale Delémont" description={site.description}>
	<HomeLead event={nextEvent} feature={feature} showEventsLink={events.length > 1} />

	<section class:list={["events-section", {"home-agenda-note": events.length === 0}]} id="news" aria-labelledby="news-title">
		{events.length > 0 ? <>
			<div class="section-heading" data-reveal>
				<h2 id="news-title">Tous les événements</h2>
				<p>Concerts, répétitions ouvertes et rendez-vous de formation : retrouvez les prochaines dates de l’UID.</p>
			</div>
			<div class="events-grid">{events.map((event, index) => <EventCard event={event} index={index} />)}</div>
		</> : <>
			<h2 id="news-title">Les événements de l’UID</h2>
			<p>Aucun événement n’est programmé pour le moment.</p>
		</>}
	</section>
	{nextEvent && feature && <HomeFeature feature={feature} />}
	<section class="formation-section" aria-labelledby="formation-title">
		<div class="section-heading section-heading--compact" data-reveal>
			<h2 id="formation-title">Grandir en musique</h2>
			<p>
				Les Lutins musiciens, les Aventuriers et Union d’Avenir accompagnent les jeunes des premières découvertes
				musicales jusqu’aux concerts en groupe.
			</p>
		</div>
		<div class="formation-links formation-links--youth" data-reveal>
			<a href="/jeunesse/lutins-musiciens/">
				<img src="/images/lutins_musiciens_illustration.jpg" alt="Illustration des Lutins musiciens" width="1280" height="573" />
				<div class="formation-link__label"><h3>Les Lutins musiciens</h3><small>De 3 à 6 ans</small></div>
			</a>
			<a href="/jeunesse/aventuriers/">
				<img src="/images/cadets.jpg" alt="Jeunes musiciens réunis devant leur local" width="1600" height="900" />
				<div class="formation-link__label"><h3>Les Aventuriers</h3><small>Dès 7 ans</small></div>
			</a>
			<a href="/jeunesse/union-davenir/">
				<img src="/images/union-davenir-groupe.jpg" alt="Les jeunes musiciens d’Union d’Avenir" width="1536" height="1004" />
				<div class="formation-link__label"><h3>Union d’Avenir</h3><small>Après la phase 1</small></div>
			</a>
		</div>
	</section>

{events.length > 0 && <PhotoLightbox />}
</BaseLayout>
