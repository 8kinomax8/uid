---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentFlow from "../../components/ContentFlow.astro";
import PageHero from "../../components/PageHero.astro";
import { lutinsAnimators, lutinsSchedule, pages } from "../../data/site";
---

<BaseLayout title="Les Lutins musiciens" description="Jardin musical pour les enfants de 3 à 6 ans à l'Union Instrumentale de Delémont.">
	<PageHero
		title="Les Lutins musiciens"
		kicker="Jeunesse"
		text="Une première rencontre ludique avec la musique, pensée pour les enfants dès 3 ans."
		image="/images/lutins_musiciens_illustration.jpg"
	/>
	<ContentFlow block={pages.lutins} image="/images/animatrices_lutins.png" className="content-flow--compact-media">
		<div slot="aside-after" class="animators-bios" aria-label="Présentation des animatrices">
			{lutinsAnimators.map((animator) => (
				<article>
					<h3>{animator.name}</h3>
					<p>{animator.text}</p>
				</article>
			))}
		</div>
	</ContentFlow>
	<section class="detail-band" aria-labelledby="lutins-horaires">
		<div class="detail-band__intro" data-reveal>
			<h2 id="lutins-horaires">Détails pratiques</h2>
			<p>Choisissez la classe qui convient à vos disponibilités et à vos possibilités.</p>
		</div>
		<div class="detail-grid" data-reveal>
			<div>
				<h3>Classes</h3>
				<ul>{lutinsSchedule.classTimes.map((time) => <li>{time}</li>)}</ul>
			</div>
			<div>
				<h3>Pratique</h3>
				<ul>{lutinsSchedule.practicalDetails.map((detail) => <li>{detail}</li>)}</ul>
			</div>
		</div>
	</section>
	<ContentFlow block={pages.lutinsDiscovery} image="/images/lutins-decouverte-2026.jpeg" className="content-flow--poster" pointsInText reverse />
</BaseLayout>
