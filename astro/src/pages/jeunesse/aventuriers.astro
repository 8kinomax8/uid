---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentFlow from "../../components/ContentFlow.astro";
import PageHero from "../../components/PageHero.astro";
import { pages } from "../../data/site";
---

<BaseLayout title="Les Aventuriers" description="Les Aventuriers: premiers instruments et musique en groupe dès 7 ans à l’Union Instrumentale Delémont.">
	<PageHero
		title="Les Aventuriers"
		kicker="Jeunesse"
		text="Commencer un instrument, rencontrer d’autres jeunes musiciens et jouer ensemble chaque vendredi."
		image="/images/cadets.jpg"
	/>
	<ContentFlow block={pages.aventuriers} image="/images/aventuriers-logo.png" className="content-flow--compact-media" />
	<ContentFlow block={pages.aventuriersDiscovery} image="/images/aventuriers-decouverte-2026.jpeg" className="content-flow--poster" pointsInText reverse>
	<aside slot="text-after" class="youth-contact" aria-label="Contact formation">
		<p>Responsable formation: Florence Harris</p>
		<a href="tel:+41765124212">076 512 42 12</a>
		<a href="mailto:cadets@fanfareuid.ch">cadets@fanfareuid.ch</a>
	</aside>
	</ContentFlow>
</BaseLayout>
