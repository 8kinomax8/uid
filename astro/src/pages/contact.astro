---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
---

<BaseLayout title="Contact" description="Contacter l'Union Instrumentale Delémont.">
	<PageHero title="Contact" kicker="Rencontre" text="Une question, une visite de répétition ou une inscription? L'Instrum vous répond." />
	<section class="contact-panel" aria-labelledby="contact-title">
		<div data-reveal>
			<h2 id="contact-title">Rue du Temple 31<br />2800 Delémont</h2>
			<p>
				Pour découvrir une répétition, poser une question aux Cadets (Aventuriers) ou contacter le Jardin musical, écrivez-nous.
			</p>
		</div>
		<div class="contact-links" data-reveal>
			<a href={`mailto:${site.email}`}>{site.email}</a>
			<a href="mailto:cadets@fanfareuid.ch">cadets@fanfareuid.ch (Union d'Avenir & Aventuriers)</a>
			<a href="mailto:lutins.musiciens@fanfareuid.ch">lutins.musiciens@fanfareuid.ch</a>
		</div>
	</section>
	<section class="contact-panel contact-panel--president" aria-labelledby="president-title">
		<div data-reveal>
			<h2 id="president-title">Guillaume Harris</h2>
			<p>Présidence Union Instrumentale Delémont (UID)</p>
		</div>
		<address class="contact-links" data-reveal>
			<span>Rue des Sillons 8<br />CH-2800 Delémont</span>
			<a href="mailto:president@fanfareuid.ch">president@fanfareuid.ch</a>
		</address>
	</section>
</BaseLayout>
