---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContentFlow from "../components/ContentFlow.astro";
const contact = (subject: string) => `mailto:president@fanfareuid.ch?subject=${encodeURIComponent(subject)}`;
---

<BaseLayout title="Soutien" description="Soutenir l’Union Instrumentale Delémont : nos nouveaux uniformes entre 2026 et 2028, La Partition et nos concerts annuels.">
	<PageHero title="Soutenir l’UID" text="Entre 2026 et 2028, notre priorité est de financer les nouveaux uniformes de l’Union Instrumentale Delémont. Entreprises et particuliers, vous pouvez nous aider à concrétiser ce projet." />
	<ContentFlow image={null} block={{
		title: "Recherche de soutiens financiers",
		body: ["Entre 2026 et 2028, l’Union Instrumentale Delémont est à la recherche de fonds pour financer ses nouveaux uniformes."]
	}}>
		<div class="support-details" slot="text-after">
			<h3>Pour les entreprises</h3>
			<p>Un <strong>dossier de partenariat</strong> a été mis en place pour soutenir nos <strong>nouveaux uniformes</strong>. Si vous êtes intéressés ou avez besoin de renseignements complémentaires, contactez Renaud Zbinden. Les coordonnées de contact figurent également dans le dossier.</p>
			<a class="button-link" href="https://fanfareuid.ch/wordpress/wp-content/uploads/2026/10/DossierPartenariat_UniformeUID2026_VF.pdf" target="_blank" rel="noreferrer">Consulter le dossier de partenariat (PDF) ↗</a>
			<h3>Pour les particuliers</h3>
			<p>Plusieurs actions vont être mises en place. Prochainement, une <strong>vente de bières artisanales</strong> et de <strong>passeports gourmands</strong> vont débuter, qui vous permettront d’aider l’UID à atteindre ses objectifs.</p>
		</div>
	</ContentFlow>
	<section class="contact-panel" aria-labelledby="uniform-contact-title">
		<div data-reveal>
			<h2 id="uniform-contact-title">Soutenir les nouveaux uniformes</h2>
			<p>Renaud Zbinden, caissier, vous renseigne sur le financement des nouveaux uniformes et les possibilités de partenariat.</p>
		</div>
		<div class="contact-links" data-reveal>
			<a href="mailto:uniformes@fanfareuid.ch">uniformes@fanfareuid.ch</a>
			<a href="tel:+41798859265">+41 79 885 92 65</a>
		</div>
	</section>
	<ContentFlow image={null} block={{
		title: "La Partition",
		body: ["La Partition est le groupe de soutien de l’Union Instrumentale Delémont. Il rassemble celles et ceux qui souhaitent accompagner notre société et soutenir ses activités musicales.", "Vous aimeriez en faire partie ? Contactez-nous pour découvrir le groupe et les possibilités de soutien."],
		cta: { label: "Rejoindre La Partition", href: contact("Rejoindre La Partition") }
	}} />
	<ContentFlow image={null} block={{
		title: "Nos concerts annuels",
		body: ["Nos concerts annuels sont des rendez-vous pour partager notre musique avec le public. Vous pouvez contribuer à leur réalisation en devenant sponsor.", "Échangeons sur les possibilités de partenariat pour un prochain concert."],
		cta: { label: "Sponsoriser un concert", href: contact("Sponsoring des concerts annuels") }
	}} />
	<section class="contact-panel" aria-labelledby="support-contact-title">
		<div data-reveal>
			<h2 id="support-contact-title">Parlons de votre soutien</h2>
			<p>Guillaume Harris, président de l’Union Instrumentale Delémont, vous répond pour La Partition et le sponsoring des concerts annuels.</p>
		</div>
		<div class="contact-links" data-reveal><a href="mailto:president@fanfareuid.ch">president@fanfareuid.ch</a></div>
	</section>
</BaseLayout>

<style>
	.support-details { grid-column: 2; }
	.support-details h3:not(:first-child) { margin-top: 32px; }
</style>
