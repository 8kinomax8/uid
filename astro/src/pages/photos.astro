---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoLightbox from "../components/PhotoLightbox.astro";
import PageHero from "../components/PageHero.astro";
import { photoGallery } from "../data/site";
---

<BaseLayout title="Photos" description="Galerie photo de l'Union Instrumentale Delémont.">
	<PageHero title="Photos" kicker="Regards" text="Des fragments de scène, de répétition et de transmission, comme autant de traces du son partagé." image="/images/Photo_ensemble.jpg" deferImage />
	<section class="photo-wall" aria-labelledby="gallery-title">
		<h2 id="gallery-title">La vie de l’Instrum</h2>
		{
			photoGallery.map((photo) => (
				<button class:list={["photo-wall__item", photo.className]} type="button" aria-label={photo.alt} data-photo-open data-photo-src={photo.src} data-photo-alt={photo.alt} data-reveal>
					<img data-deferred-src={photo.src} alt={photo.alt} width="1200" height="900" decoding="async" fetchpriority="low" />
					<noscript><img src={photo.src} alt={photo.alt} width="1200" height="900" loading="lazy" decoding="async" fetchpriority="low" /></noscript>
				</button>
			))
		}
	</section>
	<PhotoLightbox />
</BaseLayout>
