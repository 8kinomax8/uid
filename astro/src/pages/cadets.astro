---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentFlow from "../components/ContentFlow.astro";
import PageHero from "../components/PageHero.astro";
import { pages } from "../data/site";
---

<BaseLayout title="Cadets" description="Formation musicale des jeunes de l'Union Instrumentale de Delémont.">
	<PageHero
		title="Cadets UID"
		kicker="Jeunes musiciens"
		text="Apprendre un instrument, jouer en groupe et rejoindre une aventure musicale locale."
		image="/images/cadets.jpg"
	/>
	<ContentFlow block={pages.cadets} image="/images/logo_cadets.png" className="content-flow--compact-media content-flow--cadets" />
	<ContentFlow block={pages.unionDAvenir} image="/images/logo_union_davenir.png" className="content-flow--compact-media" reverse />
	<section class="cadets-team" aria-labelledby="cadets-team-title">
		<div data-reveal>
			<p class="section-kicker">Encadrement</p>
			<h2 id="cadets-team-title">Les responsables d’Union d’Avenir.</h2>
		</div>
		<p data-reveal>
			Le comité Union d’Avenir est composé de Chloé, Claire, Elodie, Emilien, Jean-Marie, Méline et Marinel.
		</p>
	</section>
	<aside class="sponsor-thanks" aria-label="Remerciements au sponsor">
		<p>Avec le précieux soutien de</p>
		<img src="/images/LogoViquodeco.jpg" alt="Viquodeco" width="4288" height="1781" loading="lazy" decoding="async" />
		<p>Merci à notre sponsor !</p>
	</aside>
</BaseLayout>
