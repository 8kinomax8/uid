---
import type { EventItem } from "../lib/wordpress";

type Props = {
	event: EventItem;
	index?: number;
};

const { event, index = 0 } = Astro.props;
---

<article class:list={["event-card", { "event-card--portrait": event.imageOrientation === "portrait" }]} style={`--delay:${index * 0.08}s`}>
	<button type="button" class="event-card__media" data-photo-gallery={JSON.stringify(event.photos)} data-photo-open data-photo-src={event.image} data-photo-alt={event.title} aria-label={`Agrandir l’image : ${event.title}`}>
		<img src={event.image} alt="" width="900" height="760" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
	</button>
	<div class="event-card__content">
		<div class="event-card__meta">
			<time datetime={event.startsAt}>{event.date}</time>
			<span>{event.location}</span>
		</div>
		<h3>{event.title}</h3>
		<p>{event.summary}</p>
		{event.href && <a class="text-link" href={event.href}>
			En savoir plus
			<span aria-hidden="true"> →</span>
		</a>}
	</div>
</article>
