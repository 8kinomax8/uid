---
import type { ContentBlock } from "../data/site";
import FactList from "./FactList.astro";

type Props = {
	block: ContentBlock;
	reverse?: boolean;
	image?: string | null;
	className?: string;
	pointsInText?: boolean;
};

const { block, reverse = false, image = "/images/Photo_ensemble.jpg", className, pointsInText = false } = Astro.props;
const hasAside = Boolean(image || (!pointsInText && block.points?.length) || Astro.slots.has("aside-after"));
const ctaIsExternal = block.cta?.external ?? /^https?:\/\//.test(block.cta?.href ?? "");
---

<section class:list={["content-flow", className, { "content-flow--reverse": reverse, "content-flow--reading": !hasAside }]}>
	<div class="content-flow__text" data-reveal>
		<h2>{block.title}</h2>
		{block.kicker && <p class="content-context">{block.kicker}</p>}
		{block.body.map((paragraph) => <p>{paragraph}</p>)}
		{
			block.cta && (
				<a class="button-link" href={block.cta.href} target={ctaIsExternal ? "_blank" : undefined} rel={ctaIsExternal ? "noreferrer" : undefined}>
					<span>{block.cta.label}</span>
					<span class="button-link__arrow" aria-hidden="true">→</span>
				</a>
			)
		}
		{pointsInText && block.points && <FactList points={block.points} />}
		<slot name="text-after" />
	</div>
	{hasAside && <div class="content-flow__aside" data-reveal>
		{image && <img src={image} alt="" width="900" height="760" loading="lazy" decoding="async" />}
		<slot name="aside-after" />
		{!pointsInText && block.points && <FactList points={block.points} />}
	</div>}
</section>
