---
import type { EventItem, HomeFeature } from '../lib/wordpress';
type Props = { event?: EventItem; feature: HomeFeature | null };
const { event, feature } = Astro.props;
const title = event?.title ?? feature?.title ?? 'La musique se partage';
const summary = event?.summary ?? feature?.summary ?? 'Découvrez les formations jeunesse de l’Union Instrumentale Delémont et trouvez votre place dans la musique.';
const image = event?.photos[0] ?? feature?.image;
const href = event?.href ?? (!event ? feature?.href ?? '/jeunesse/' : undefined);
const linkLabel = event ? 'En savoir plus' : feature?.linkLabel ?? 'Découvrir les formations';
const gallery = event ? { 'data-photo-gallery': JSON.stringify(event.photos), 'data-photo-open': true } : {};
---
<section class:list={['home-lead', { 'home-lead--portrait': image && image.height > image.width }]} aria-labelledby="home-title" data-home-lead={event ? 'event' : feature ? 'feature' : 'youth'}>
 <h1 class="home-lead__identity" id="home-title">Union Instrumentale<br />Delémont</h1>
 <div class="home-lead__content">
  <h2 class:list={['home-lead__title', {'home-lead__title--long': title.length > 55}]}>{title}</h2>
  {event && <p class="home-lead__when"><time datetime={event.startsAt}>{event.date}</time><span>{event.location}</span></p>}
  <p class="home-lead__summary">{summary}</p>
  <div class="hero-actions">
   {href ? <a class="button-link" href={href}>{linkLabel}</a> : event && <a class="button-link" href={event.image} {...gallery}>Voir l’affiche</a>}
   {event && <a class="ghost-link" href="/agenda/">Tout l’agenda</a>}
  </div>
 </div>
 {event ? <a class="home-lead__media" href={event.image} {...gallery} aria-label={`Agrandir l’affiche : ${event.title}`}>
  <img src={event.image} alt={event.imageAlt} width={image?.width ?? 900} height={image?.height ?? 1200} fetchpriority="high" decoding="async" />
 </a> : <figure class="home-lead__media">
  <img src={image?.src ?? '/images/Photo_ensemble.jpg'} alt={image?.alt ?? 'Les musiciens de l’Union Instrumentale Delémont réunis en ensemble'} width={image?.width ?? 1800} height={image?.height ?? 1200} fetchpriority="high" decoding="async" />
 </figure>}
</section>
